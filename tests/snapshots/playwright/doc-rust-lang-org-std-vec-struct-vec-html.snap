                    - text: (&mut self) ->
                    - link "Option" [ref=f84e2346]
                    - text: <T>
                - text: Collapse
              - generic:
                - paragraph:
                  - text: Removes the last element from a vector and returns it, or
                  - link [ref=f84e2349]:
                    - code: None
                  - text: if it is empty.
                - paragraph:
                  - text: If you’d like to pop the first element, consider using
                  - link [ref=f84e2352]:
                    - code: VecDeque::pop_front
                  - text: instead.
                - heading "Examples" [level=5] [ref=f84e2354]
                - code: let mut vec = vec![1, 2, 3]; assert_eq!(vec.pop(), Some(3)); assert_eq!(vec, [1, 2]);
                - heading "Time complexity" [level=5] [ref=f84e2358]
                - paragraph:
                  - text: Takes
                  - emphasis: O
                  - text: (1) time.
            - group:
