                    - text: (
                    - link "&mut T" [ref=f84e2369]
                    - text: ) ->
                    - link "bool" [ref=f84e2370]
                    - text: ) ->
                    - link "Option" [ref=f84e2371]
                    - text: <T>
                - text: Collapse
              - generic:
                - paragraph:
                  - text: Removes and returns the last element from a vector if the predicate returns
                  - code: "true"
                  - text: ", or"
                  - link [ref=f84e2375]:
                    - code: None
