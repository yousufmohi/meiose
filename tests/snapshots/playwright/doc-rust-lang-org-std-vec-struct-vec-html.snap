                - heading "Examples" [level=5] [ref=f84e1082]
                - code: "let v = vec![1, 2, 3]; // Deconstruct the vector into parts. let (p, len, cap) = v.into_parts(); unsafe { // Overwrite memory with 4, 5, 6 for i in 0..len { p.add(i).write(4 + i); } // Put everything back together into a Vec let rebuilt = Vec::from_parts(p, len, cap); assert_eq!(rebuilt, [4, 5, 6]); }"
