                - heading "Examples" [level=5] [ref=f84e2460]
                - code: let mut v = vec![1, 2, 3]; v.clear(); assert!(v.is_empty());
            - group:
              - generic:
                - generic:
                  - generic:
                    - text: "1.0.0 (const: 1.87.0) ·"
                    - link "Source" [ref=f84e2468]: ../../src/alloc/vec/mod.rs.html#3100
                  - heading [level=4] [ref=f84e2469]:
