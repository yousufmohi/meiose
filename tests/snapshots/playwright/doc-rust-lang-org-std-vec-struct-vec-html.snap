                - heading [level=4] [ref=f84e3331]:
                  - text: pub fn
                  - link "get" [ref=f84e3332]
                  - text: "<I>(&self, index: I) ->"
                  - link "Option" [ref=f84e3333]
                  - text: <&<I as
                  - link "SliceIndex" [ref=f84e3334]: ../slice/trait.SliceIndex.html
                  - text: <
                  - link "[T]" [ref=f84e3335]
                  - text: ">>::"
                  - link "Output" [ref=f84e3336]: ../slice/trait.SliceIndex.html#associatedtype.Output
